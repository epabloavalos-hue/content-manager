# Postgres connection string (Neon, Vercel Postgres, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob — created automatically when you connect a Blob store to the
# project; Vercel injects this at build/runtime, only needed locally for `vercel env pull`
BLOB_READ_WRITE_TOKEN=""

# Telegram — bot notifications
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""
